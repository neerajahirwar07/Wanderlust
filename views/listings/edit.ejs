<% layout("layouts/boilerplate.ejs") %>
<body>
   <div class="row">
   <div class="col-8 offset-2">
    <form action="/listings/<%= listing._id%>?_method=PUT" method="POST" novalidate class="needs-validation"
       enctype="multipart/form-data">
        <br/>
           <h2>Edit  listing</h2>
        <div class="mb-3">
           <label for="title" class="form-level">title</label>
          <input type="text" name="list[title]" value="<%= listing.title %>" class="form-control">
            <div class="valid-feedback">title looks good !</div>

        </div>

        <div class="mb-3">
            <label for="description" class="form-level">Description</label>
            <textarea name="list[description]" placeholder="description" class="form-control" required><%= listing.description %></textarea>
              <div class="invalid-feedback">description should be valid </div>
        </div>
        <div class="mb-3">
         <b> orignal image </b> <br>
          <img src="<%= listing.image.url %>" height="100px" width="100px">
        </div>
        <div class="mb-3">
        <label for="image" class="form-level">uplaod new image </label>
        <input type="file" name="list[image]"  class="form-control" >
        
        </div>

        <div class="mb-3"> 
            <label for="number" class="form-level">price</label>
            <input type="number" name="list[price]" value="<%= listing.price %>" class="form-control" min="0" required>
              <div class="invalid-feedback">price should be valid </div>
        </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="text" class="form-level">Location</label>
                    <input type="text" name="list[location]" value="<%= listing.location %>" class="form-control" required>
                    <div class="invalid-feedback">location should be required </div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="text" class="form-level">country</label>
                    <input type="text" name="list[country]" value="<%= listing.country %>" class="form-control" required>
                      <div class="invalid-feedback">country name  should be valid </div>
                </div>
            </div>
       <br/>
     <button type="submit" class="btn btn-primary">Edit</button>
    </form>
  </div>
</div>
    
</body>
