<% layout("layouts/boilerplate") %>
<body>
  <div class="col-md-6 offset-md-3 mt-4">
    <div class="card p-4">
      <h3 class="mb-3">Confirm &amp; Pay</h3>

      <img src="<%= listing.image.url %>" class="img-fluid rounded mb-3" style="max-height:200px; object-fit:cover;" alt="<%= listing.title %>">

      <h5><%= listing.title %></h5>
      <p class="mb-1"><%= listing.location %>, <%= listing.country %></p>
      <hr>
      <p class="mb-1"><b>Check-in:</b> <%= booking.checkIn.toDateString() %></p>
      <p class="mb-1"><b>Check-out:</b> <%= booking.checkOut.toDateString() %></p>
      <p class="mb-1"><b>Guests:</b> <%= booking.guests %></p>
      
      <p class="mb-1"><b>Nights:</b> <%= booking.nights %></p>
      <% if(booking.discountApplied) { %>
        <p class="mb-1 text-success"><b>15% Discount Applied ✓</b></p>
      <% } %>
      <h5 class="mt-3">Total: &#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></h5>

      <div id="payment-error" class="text-danger mt-2" style="display:none;"></div>

      <button id="pay-btn" class="btn btn-success mt-3">Pay &#8377;<%= booking.totalPrice.toLocaleString("en-IN") %> with Razorpay</button>
      <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary mt-2">Cancel</a>
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    document.getElementById("pay-btn").addEventListener("click", function () {
      const errorBox = document.getElementById("payment-error");
      errorBox.style.display = "none";

      const options = {
        key: "<%= razorpayKeyId %>",
        amount: <%= order.amount %>,
        currency: "<%= order.currency %>",
        name: "Wanderlust",
        description: "<%= listing.title %> booking",
        order_id: "<%= order.id %>",
        handler: function (response) {
          fetch("/bookings/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              bookingId: "<%= booking._id %>",
            }),
          })
            .then((res) => res.json())
            .then((data) => {
              if (data.success) {
                window.location.href = data.redirectUrl;
              } else {
                errorBox.textContent = "Payment verification failed. Please try again.";
                errorBox.style.display = "block";
              }
            })
            .catch(() => {
              errorBox.textContent = "Something went wrong verifying payment.";
              errorBox.style.display = "block";
            });
        },
        theme: { color: "#fe424d" },
      };

      const rzp = new Razorpay(options);
      rzp.on("payment.failed", function () {
        errorBox.textContent = "Payment failed. Please try again with a different method.";
        errorBox.style.display = "block";
      });
      rzp.open();
    });
  </script>
</body>