<!--  this is for success -->
<% if(locals.success && locals.success.length){ %>
    <div class="alert alert-success alert-dismissible fade show mt-2 col-4 offset-3" role="alert">
         <%= locals.success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
   
<% } %>
<!--  this is for error  -->

<% if(locals.error && locals.error.length){ %>
      <div class="alert alert-danger alert-dismissible fade show mt-2 col-4 offset-3" role="alert">
         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
         <%= error %>
    </div>
   
 <% } %>