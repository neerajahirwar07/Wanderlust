<% layout("layouts/boilerplate") %>
<body>
    <div class="row col-6 offset-3">
        <h2 class="mt-3"><b>Signup Wanderlust!</b></h2>
    <form action="/signup" method="POST"  class="needs-validation" novalidate>
         <div class="mt-1">
            <label for="username" class="from-label">username</label>
            <input type="username" class="form-control" name="username" required>
            <div class="valid-feedback">Nice username!</div>
           
        </div>
        <div class="mt-1">
            <label for="email" class="from-label">email</label>
            <input type="email" class="form-control" name="email" required>
            <div class="valid-feedback">cool</div>
        </div>
         <div class="mt-1">
            <label for="passport" class="from-label">passport</label>
            <input type="password" class="form-control" name="password" required>
        </div>
       
            <div class="mt-1">
                <button class="btn btn-success mt-3">Signup</button>
            </div>   
    </form>
    
</body>